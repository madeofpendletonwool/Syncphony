# Copy to .env and adjust. Every setting has a sensible development default.

# Address the server listens on.
SYNCPHONY_ADDR=:8080
# Public URL people use to reach Syncphony. Used for OAuth redirects (Spotify)
# and links, so it must be HTTPS in production.
SYNCPHONY_BASE_URL=http://localhost:8080
# SQLite database and other persistent state.
SYNCPHONY_DATA_DIR=./data
# debug | info | warn | error
SYNCPHONY_LOG_LEVEL=info

# --- Coming in Phase 1/3 (not read yet) ---
# Master key for encrypting linked service credentials. Generate with:
#   openssl rand -base64 32
# SYNCPHONY_VAULT_KEY=
# Spotify developer app credentials.
# SYNCPHONY_SPOTIFY_CLIENT_ID=
# SYNCPHONY_SPOTIFY_CLIENT_SECRET=
